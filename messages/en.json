    "OurSolutions": {
      "heading": "Our Solutions",
      "description": "Royal Nano Ceramic offers advanced protection services for vehicles, aircraft, boats, and motorcycles in Egypt. Using the best international materials and modern nano-ceramic technologies, the company ensures top-level protection and quality, delivering a unique experience that makes them the leading choice in the market.",
      "solutions": [
        {
          "title": "Luxury Car Protection",
          "paragraph": "Our ceramic coating ensures long-lasting protection for luxury vehicles, preserving their shine and guarding against scratches and environmental damage."
        },
        {
          "title": "Aircraft Protection",
          "paragraph": "We provide nano technology coatings that protect aircraft from UV damage and corrosion, keeping them in excellent condition over time."
        },
        {
          "title": "Yacht Protection",
          "paragraph": "Our nano coatings offer protection against saltwater and UV rays, helping to maintain the yacht's appearance and durability."
        },
        {
          "title": "Motorcycle Protection",
          "paragraph": "Specialized nano coatings protect motorcycles from scratches and wear, ensuring they remain in great condition across various environments."
        }
      ]
    },
