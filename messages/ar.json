    "OurSolutions": {
      "heading": "حلولنا",
      "description": "تقدم رويال نانو سيراميك خدمات حماية متقدمة للسيارات والطائرات والقوارب والدراجات النارية في مصر. باستخدام أفضل المواد الدولية وتقنيات النانو سيراميك الحديثة، تضمن الشركة أعلى مستويات الحماية والجودة، مما يوفر تجربة فريدة تجعلها الخيار الأول في السوق.",
      "solutions": [
        {
          "title": "حماية السيارات الفاخرة",
          "paragraph": "توفر طلاءات السيراميك الخاصة بنا حماية طويلة الأمد للسيارات الفاخرة، مما يحافظ على لمعانها ويقيها من الخدوش والأضرار البيئية."
        },
        {
          "title": "حماية الطائرات",
          "paragraph": "نقدم طلاءات بتقنية النانو تحمي الطائرات من أضرار الأشعة فوق البنفسجية والتآكل، مما يحافظ على حالتها الممتازة بمرور الوقت."
        },
        {
          "title": "حماية اليخوت",
          "paragraph": "توفر طلاءات النانو الخاصة بنا حماية ضد مياه البحر والأشعة فوق البنفسجية، مما يساعد في الحفاظ على مظهر اليخت ومتانته."
        },
        {
          "title": "حماية الدراجات النارية",
          "paragraph": "توفر طلاءات النانو المتخصصة حماية للدراجات النارية من الخدوش والتآكل، مما يضمن بقائها في حالة جيدة في مختلف البيئات."
        }
      ]
    },
